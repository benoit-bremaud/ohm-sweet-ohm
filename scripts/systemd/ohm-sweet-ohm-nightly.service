[Unit]
Description=Nightly local CI of ohm-sweet-ohm: just nightly, tier L3 (#68, skill local-ci), on a clean origin/main worktree (#71)
OnFailure=ohm-sweet-ohm-nightly-failed.service

[Service]
Type=oneshot
# The user manager's PATH has no ~/.local/bin, where mise lives; mise brings the pinned tools.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=REPO=%h/Documents/02_personal/ohm-sweet-ohm WT=%h/.cache/nightly/ohm-sweet-ohm
# Never the working checkout: it may sit on a feature branch, be dirty or behind origin/main
# (agents-skills#427). '-': a catch-up run before the network is up uses the last fetched origin/main.
ExecStartPre=-/usr/bin/git -C ${REPO} fetch --quiet origin main
ExecStartPre=/bin/sh -c 'test -d "$WT" || { git -C "$REPO" worktree prune && git -C "$REPO" worktree add --detach "$WT" origin/main; }'
ExecStartPre=/usr/bin/git -C ${WT} reset --quiet --hard origin/main
# No -x: the ignored node_modules is kept so the frozen install stays fast.
ExecStartPre=/usr/bin/git -C ${WT} clean -ffdq
ExecStartPre=%h/.local/bin/mise trust --quiet ${WT}/mise.toml
ExecStartPre=/bin/sh -c 'cd "$WT" && exec mise x -- pnpm install --frozen-lockfile --ignore-scripts'
ExecStart=/bin/sh -c 'cd "$WT" && exec mise x -- just nightly'
