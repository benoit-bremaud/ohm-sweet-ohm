[Unit]
Description=Nightly local CI of ohm-sweet-ohm: just nightly, tier L3 (#68, skill local-ci)
OnFailure=ohm-sweet-ohm-nightly-failed.service

[Service]
Type=oneshot
# The user manager's PATH has no ~/.local/bin, where mise lives; mise brings the pinned tools.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Documents/02_personal/ohm-sweet-ohm
ExecStart=%h/.local/bin/mise x -- just nightly
