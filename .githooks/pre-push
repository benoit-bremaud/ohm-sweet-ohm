#!/bin/sh
# Local stand-in for CI: format, lint, types, tests, Semgrep and gitleaks before every push.
# Enable once per clone: git config core.hooksPath .githooks
# The full gate (Docker image, render, audit) is `make check-local`, run before a merge.
set -e
PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$HOME/.asdf/bin:$PATH"
export PATH
cd "$(git rev-parse --show-toplevel)"
# The checks read the files on disk: refuse when they differ from the commits being pushed.
if ! git diff --quiet HEAD --; then
  echo "pre-push: uncommitted changes, commit or stash them first" >&2
  exit 1
fi
make check-fast
