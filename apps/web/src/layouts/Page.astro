---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Origins the page loads images from, added to the CSP of this response. */
  imageOrigins?: readonly string[];
}

const { title, description, imageOrigins = [] } = Astro.props;
Astro.csp?.insertDirective(`img-src ${["'self'", ...imageOrigins].join(' ')}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10161c" media="(prefers-color-scheme: dark)" />
    <title>{title} · Ohm Sweet Ohm</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="frame">
      <header class="bar">
        {/* Plain text until the home page exists (M2): a link to / would only reach the 404. */}
        <span class="wordmark" translate="no">
          Ohm Sweet Ohm
        </span>
        <p class="tagline">Reusable circuit blocks and their variants</p>
      </header>
      <main id="main" class="page">
        <slot />
      </main>
      <footer class="bar foot">
        <p>Schematics are published under CC BY-SA 4.0; the code is MIT.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: -100%;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding: var(--space-2) var(--space-3);
    background: var(--copper);
    color: var(--copper-ink);
  }

  .skip:focus-visible {
    top: var(--space-2);
  }

  /* The drawing sheet: an inner border and an outer trim line, zone ticks along the top. */
  .frame {
    position: relative;
    width: min(var(--sheet-max), 100% - 2 * max(var(--space-2), env(safe-area-inset-left)));
    margin: var(--space-4) auto;
    background: var(--sheet);
    border: 1px solid var(--ink);
    outline: 1px solid var(--rule);
    outline-offset: var(--space-1);
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--space-2);
    pointer-events: none;
    background: repeating-linear-gradient(
      to right,
      var(--ink-muted) 0 1px,
      transparent 1px calc(100% / 8)
    );
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-6) var(--space-4) var(--space-4);
    border-bottom: var(--rule-strong) solid var(--copper);
  }

  .foot {
    border-bottom: 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: var(--size-caption);
  }

  .wordmark {
    font-weight: 600;
    font-size: var(--size-title);
    letter-spacing: -0.01em;
  }

  .tagline {
    color: var(--ink-muted);
    font-size: var(--size-label);
  }

  .page {
    padding: var(--space-8) var(--space-4) var(--space-12);
  }

  @media (min-width: 48rem) {
    .bar,
    .page {
      padding-inline: var(--space-8);
    }
  }
</style>
