---
import Page from '../layouts/Page.astro';

Astro.response.status = 404;
---

<Page title="No such page" description="This page does not exist in the catalogue.">
  <h1>No such page</h1>
  <p class="lead">
    Nothing lives at this address. Block pages look like <code>/blocks/&lt;slug&gt;</code>; check
    the link that brought you here.
  </p>
</Page>

<style>
  .lead {
    margin-top: var(--space-4);
    max-width: var(--measure);
  }
</style>
